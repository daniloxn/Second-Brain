{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Segundo Cérebro",
  "version": "0.1.0",
  "identifier": "com.exemplo.tauribasico",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Segundo Cérebro",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 480
      },
      {
        "label": "ilha",
        "title": "Segundo Cérebro · Chat",
        "url": "index.html?ilha",
        "width": 248,
        "height": 48,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
